      "account": "alalapi",
      "runtime_env": "FIGMA_API_KEY",
      "ownership": "owner-approved global tool API key",
      "consumers": [
        "~/.claude.json#mcpServers.figma"
      ],
      "launcher": "scripts/tool_credentials.py run figma-api -- <existing command and args>",
