{
  "schema_version": "2.0",
  "schema_language": "hub-typed-validator-v2",
  "declaration_validator": "hub.connection_records.validate_declaration",
  "record_validator": "hub.connection_records.validate_result",
  "business_fields": {
    "current_work.objective": "string",
    "current_work.phase": "string",
    "current_work.round": "string",
    "current_work.status": "status",
    "current_work.completed": "boolean",
    "current_work.accepted": "boolean",
    "current_work.next_action": "string",
    "current_work.owner_role": "string",
    "progress.completed": "integer",
    "progress.total": "integer",
    "progress.counting_basis": "string",
    "progress.milestones": "milestones",
    "blockers": "blockers",
    "verification.status": "string",
    "verification.evidence_refs": "strings",
    "verification.accepted_basis": "string",
    "delivery.status": "delivery",
    "delivery.remote": "string",
    "delivery.branch": "string",
    "delivery.commit": "commit",
    "delivery.receipt_ref": "string"
  },
  "nullable": "all fields; each null requires a reason",
  "enums": {
    "status": [
      "active",
      "blocked",
      "complete",
      "paused",
      "unknown"
    ],
    "delivery": [
      "delivered",
      "local",
      "pending_delivery",
      "unknown"
    ]
  },
  "metric_quality_semantics": {
    "good": "valid",
    "missing": "missing",
    "unknown": "unknown",
    "not_applicable": "not_applicable",
    "invalid": "error"
  },
  "metric_value_rule": "good requires a finite number and null reason; every other quality requires null value and a reason",
  "metric_contract": {
    "schema_version": "2.0",
    "record_validator": "hub.metrics.validate_metric",
    "definition_projector": "hub.metrics.metric_definition",
    "catalog_projector": "hub.metrics.metric_catalog",
    "record_fields": [
      "business_at",
      "counting_basis",
      "dimensions",
      "metric_id",
      "observed_at",
      "project_id",
      "quality",
      "reason",
      "source_ref",
      "source_version",
      "unit",
      "value"
    ],
    "record_identity_fields": [
      "project_id",
      "metric_id"
    ],
    "record_key_fields": [
      "project_id",
      "metric_id",
      "unit",
      "dimensions",
      "counting_basis"
    ],
    "record_definition_selectors": [
      "unit",
      "dimension keys",
      "dimensions.scope",
      "counting_basis"
    ],
    "record_dynamic_fact_fields": [
      "value",
      "dimension values except dimensions.scope",
      "observed_at",
      "business_at",
      "source_ref",
      "source_version",
      "quality",
      "reason"
    ],
    "catalog_definition_fields": [
      "aggregation",
      "counter_reset",
      "counting_basis",
      "definition_id",
      "description",
      "dimension_keys",
      "display_name",
      "metric_id",
      "metric_kind",
      "scope_id",
      "unit",
      "window"
    ],
    "metric_kinds": [
      "counter",
      "duration",
      "gauge",
      "ratio",
      "timestamp"
    ],
    "aggregations": [
      "latest",
      "max",
      "min",
      "none",
      "sum",
      "weighted_ratio"
    ],
    "counter_resets": [
      "never",
      "not_applicable",
      "source_defined",
      "window"
    ],
    "window_kinds": [
      "calendar",
      "event",
      "instant",
      "lifetime",
      "rolling"
    ],
    "quality_semantics": {
      "good": "valid",
      "missing": "missing",
      "unknown": "unknown",
      "not_applicable": "not_applicable",
      "invalid": "error"
    },
    "scope_rule": "dimensions.scope is an optional stable identifier; all dimension keys are identifiers",
    "catalog_rule": "one shared definition per metric_id/unit/scope_id/dimension-key/counting-basis identity; dynamic values never enter definitions"
  },
  "metric_source_contract": {
    "schema_version": "1.0",
    "config_validator": "hub.metric_collect.validate_metric_source_config",
    "top_level_fields": [
      "schema_version",
      "projects"
    ],
    "project_common_fields": [
      "adapter",
      "github_repository",
      "validation_reports"
    ],
    "adapter_project_fields": {
      "declared": [
        "sources"
      ],
      "novel": [],
      "unmapped": [],
      "manga": [
        "batch_id",
        "data_root",
        "project_dbs",
        "review_db"
      ],
      "wechat": [],
      "anime": [
        "metadata_root"
      ],
      "pixel": [
        "metadata_root"
      ],
      "study": [],
      "story": [],
      "zarathustra": [
        "editorial_root"
      ],
      "cognitive": [],
      "music": [
        "data_root"
      ],
      "continuation": [
        "data_root",
        "universe_id"
      ],
      "validation_runs": [],
      "downloader": [],
      "workspace_checks": [],
      "hub_activity": [],
      "mpv": [
        "project_files"
      ],
      "client_fixture": [
        "report_path",
        "report_root"
      ],
      "storage_evidence": [
        "evidence_path",
        "evidence_root"
      ],
      "magnet_batch": [],
      "jav_batch": [
        "data_root"
      ]
    },
    "declared_source_fields": [
      "business_time",
      "metrics",
      "path"
    ],
    "declared_metric_fields": [
      "counting_basis",
      "dimensions",
      "id",
      "operation",
      "selector",
      "unit"
    ],
    "validation_report_fields": {
      "feature_report": [
        "format",
        "id",
        "path",
        "root",
        "source_files",
        "test_scope"
      ],
      "gate_arrays": [
        "format",
        "id",
        "path",
        "root"
      ],
      "universal_player_guard_result_v1": [
        "format",
        "id",
        "path",
        "root",
        "suite"
      ]
    },
    "forbidden_dynamic_fact_fields": [
      "accepted",
      "business_at",
      "candidate_revision",
      "completed",
      "delivery",
      "observed_at",
      "quality",
      "reason",
      "rework_count",
      "source_version",
      "status",
      "submission_attempt",
      "value"
    ],
    "forbidden_dynamic_dimension_fields": [
      "accepted",
      "business_at",
      "business_time",
      "candidate_revision",
      "completed",
      "completed_at",
      "count",
      "created_at",
      "decision",
      "delivery",
      "finished_at",
      "observed_at",
      "phase",
      "progress",
      "quality",
      "reason",
      "result",
      "revision",
      "rework_count",
      "round",
      "source_version",
      "started_at",
      "status",
      "submission_attempt",
      "time",
      "timestamp",
      "total",
      "updated_at",
      "value",
      "verdict",
      "version"
    ],
    "path_rule": "all relative components and absolute roots use hub.connection_records.credential_path_component",
    "fact_rule": "configuration selects sources and definitions; values/status/times/versions are generated by collectors"
  },
  "read_statuses": [
    "authority_drift",
    "disabled",
    "invalid",
    "missing_declaration",
    "missing_source",
    "offline",
    "permission_denied",
    "removed_local",
    "resolved",
    "unsafe_path"
  ],
  "source_contract": "one relative current_state source; typed path or exact Markdown heading/label",
  "declaration_fact_rule": "declaration contains stable source selection/mapping only; business values/status/times are generated by the resolver",
  "permission_rule": "explicit connection_read_allowed=false denies before root access; absent field falls back to enabled",
  "protected_sources": "no control/environment/credential path components in roots or sources; aliases are rechecked",
  "output_shell": "exact snapshot/row/authority/head/coverage/freshness fields; valid project IDs, nonempty names, strict numeric/boolean types",
  "value_maps": "all declared and provenance targets must match the field type, including unselected entries",
  "review_contract": {
    "schema_version": "review-flow.v1",
    "case_factory": "hub.review_contract.new_review_case",
    "event_reducer": "hub.review_contract.apply_review_event",
    "record_validator": "hub.review_contract.validate_review_case",
    "required_review_stage_sets": [
      [
        "first_review"
      ],
      [
        "first_review",
        "second_review"
      ]
    ],
    "states": [
      "awaiting_submission",
      "under_review",
      "pending_rework",
      "rework_in_progress",
      "awaiting_acceptance"
    ],
    "event_types": [
      "submit",
      "decide",
      "claim_rework",
      "complete_rework"
    ],
    "verdicts": [
      "approve",
      "reject"
    ],
    "version_binding": {
      "case_fields": [
        "project_id",
        "item_id",
        "required_review_stages",
        "initial_candidate_revision",
        "initial_candidate_hash"
      ],
      "submission_fields": [
        "candidate_revision",
        "candidate_hash"
      ],
      "decision_fields": [
        "submission_id",
        "candidate_revision",
        "candidate_hash"
      ],
      "history_binding": "ordered_full_event_replay",
      "rework_restart_stage": "first_review",
      "acceptance_state": "awaiting_acceptance"
    },
    "concurrency": {
      "event_identity_field": "event_id",
      "compare_and_swap_field": "expected_sequence",
      "duplicate_policy": "same_event_is_idempotent",
      "conflict_policy": "reject"
    }
  },
  "lifecycle": "completed, accepted and delivery.status are independent source facts"
}
